      "Bash(supabase link:*)", "Bash(supabase db push:*)", "Bash(supabase functions deploy:*)", "Bash(supabase secrets:*)",
      "Bash(npx vercel:*)", "Bash(vercel:*)", "Bash(gh pr merge:*)", "Bash(gh pr review:*)", "Bash(gh repo delete:*)",
      "Bash(gh secret list:*)", "Bash(git push --force:*)", "Bash(git push -f:*)", "Bash(git reset --hard:*)"
    ]
  },
  "hooks": {
    "SessionStart": [

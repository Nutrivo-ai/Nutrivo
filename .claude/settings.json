      "Bash(make:*)", "Bash(pnpm:*)", "Bash(uv:*)", "Bash(npx playwright:*)",
      "Bash(scripts/env/run.sh:*)", "Bash(bash scripts/bootstrap/check-tools.sh)", "Bash(bash scripts/bootstrap/github-setup.sh:*)",
      "Bash(supabase start:*)", "Bash(supabase stop:*)", "Bash(supabase status:*)", "Bash(supabase db reset:*)",
      "Bash(supabase test db:*)", "Bash(supabase migration new:*)", "Bash(supabase gen types:*)", "Bash(supabase functions serve:*)",
      "Bash(gh auth status)", "Bash(gh repo list:*)", "Bash(gh repo view:*)", "Bash(gh issue:*)", "Bash(gh pr create:*)",
      "Bash(gh pr view:*)", "Bash(gh pr checks:*)", "Bash(gh pr edit:*)", "Bash(gh pr list:*)", "Bash(gh pr comment:*)",
      "Bash(gh run:*)", "Bash(gh label:*)", "Bash(gh api:*)",
      "Bash(git status:*)", "Bash(git diff:*)", "Bash(git log:*)", "Bash(git switch:*)", "Bash(git add:*)",
      "Bash(git commit:*)", "Bash(git fetch:*)", "Bash(git pull:*)", "Bash(git push:*)", "Bash(git rebase:*)",
      "Bash(git mv:*)", "Bash(git init:*)", "Bash(git remote:*)"
    ],
    "deny": [
      "Edit(./supabase/tests/gates/**)", "Edit(./worker/tests/gates/**)", "Edit(./fixtures/golden/**)",
      "Edit(./content/accepted/**)", "Edit(./.milestone)", "Edit(./spec/acceptance.yaml)", "Edit(./spec/nfr.yaml)",

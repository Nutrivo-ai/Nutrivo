BEDROCK_MODEL_EXTRACTION=             # Claude Opus 5.5: eu.anthropic.claude-opus-5-5
ANTHROPIC_API_KEY=                    # dev only (D-11): never set in staging or production
SES_FROM_ADDRESS=noreply@mail.nutrivo.ai
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
